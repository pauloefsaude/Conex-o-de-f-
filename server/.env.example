# Copie para .env e ajuste. Nunca envie o .env para o repositório.
PORT=4000
PUBLIC_URL=http://localhost:4000

# OBRIGATÓRIO em produção: string aleatória de 32+ caracteres
# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Em produção, liste as origens do painel/site (o app nativo não usa CORS)
CORS_ORIGINS=*

# Curtidas por 24h no plano gratuito
FREE_DAILY_LIKES=50

# E-mail transacional (https://resend.com). Sem chave: links aparecem no console (só dev).
RESEND_API_KEY=
MAIL_FROM=Conexão de Fé <nao-responda@seudominio.com.br>

# IA opcional para sugestões de biografia (https://console.anthropic.com). Sem chave: dicas por regras.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# 1 = exige e-mail confirmado para descobrir/conversar
REQUIRE_EMAIL_VERIFIED=0

# SOMENTE DEV: botão de premium de teste (ignorado quando NODE_ENV=production)
DEV_PREMIUM=1

# Banco e fotos (padrão: ./data)
# DB_FILE=./data/conexao.db
# UPLOAD_DIR=./data/uploads
